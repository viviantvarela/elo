# Postgres do Neon (Project → Connection string → Pooled connection)
# Sem esta variável o Elo usa data/elo.json (bom só para desenvolvimento local).
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Conexões por lambda. Com o pooler do Neon, 1–3 é suficiente e evita esgotar o limite.
PG_POOL_MAX=3

# Opcional: fuso usado no relatório e no seed
TZ=America/Sao_Paulo
