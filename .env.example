# ==============================================================================
# Elo — Configuração de Ambiente (Supabase + Banco de Dados)
# Copie para `.env.local` no desenvolvimento ou configure no painel da Vercel.
# ==============================================================================

# 1. Supabase (Projeto `elo` — ref: euvlzkbafqwzonlwlhvd, região: sa-east-1)
NEXT_PUBLIC_SUPABASE_URL="https://euvlzkbafqwzonlwlhvd.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-ou-publishable-key-do-supabase"

# Chave secreta de servidor (NUNCA exponha com NEXT_PUBLIC_)
# Necessária para o driver HTTP transacional do Supabase (`elo_read_snapshot` / `elo_write_snapshot`).
# Obtenha em: Supabase Dashboard → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=""

# 2. Alternativa Postgres direto (opcional — ex.: Supabase Session Pooler / Neon / PGlite)
# Se preferir conexão TCP `pg.Pool` em vez da API HTTPS do Supabase:
DATABASE_URL=""

# 3. Seleção explícita de driver (opcional: "supabase" | "postgres" | "json")
# Por padrão, escolhe automaticamente:
#   1º `supabase` (quando NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY estão definidos)
#   2º `postgres` (quando DATABASE_URL está definido)
#   3º `json`     (arquivo local `data/elo.json` para desenvolvimento offline)
ELO_DB_DRIVER=""

# 4. Modo demonstração ("true" mantém troca rápida de perfis; "false" exige login Supabase em todas as rotas)
NEXT_PUBLIC_DEMO_MODE="true"
